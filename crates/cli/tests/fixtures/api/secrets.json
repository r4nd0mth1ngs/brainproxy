{
  "openapi": "3.0.3",
  "info": {"title": "Leaky", "version": "1"},
  "servers": [{"url": "http://fakeuser:FAKE-SERVER-PASSWORD@127.0.0.1:18080/v1?api_key=FAKE-SERVER-QUERY-KEY"}],
  "paths": {
    "/things/{token}": {
      "post": {
        "operationId": "createThing",
        "parameters": [
          {"name": "token", "in": "path", "required": true, "schema": {"type": "string"}, "example": "FAKE-PATH-TOKEN"},
          {"name": "api_key", "in": "query", "required": true, "schema": {"type": "string"}, "example": "FAKE-QUERY-KEY"},
          {"name": "X-Auth-Token", "in": "header", "required": true, "schema": {"type": "string", "default": "FAKE-HEADER-TOKEN"}},
          {"name": "session", "in": "cookie", "required": true, "schema": {"type": "string"}, "example": "FAKE-COOKIE-VALUE"},
          {"name": "limit", "in": "query", "schema": {"type": "integer", "example": 3}}
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "example": {"name": "thing", "password": "FAKE-BODY-PASSWORD", "nested": {"apiKey": "FAKE-NESTED-KEY"}}
            }
          }
        }
      }
    }
  }
}
