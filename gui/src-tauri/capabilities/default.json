{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: the cli and app_pid commands (allowed by default as app commands), file dialogs, opening assertivesolutions.io and brainproxy release links in the browser, and opening or showing a downloaded brainproxy installer.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://assertivesolutions.io/*" }, { "url": "https://github.com/r4nd0mth1ngs/brainproxy/releases/*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DOWNLOAD/brainproxy-gui-*" }]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}
